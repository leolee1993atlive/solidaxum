    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.7.0",
    "bits-ui": "^2.17.2",
    "clsx": "^2.1.1",
    "happy-dom": "^20.10.6",
