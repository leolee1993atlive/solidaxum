{
  "arrowParens": "always",
  "semi": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "plugins": [
    "prettier-plugin-svelte",
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ],
  "importOrder": [
    "^svelte$",
    "^svelte/(.*)$",
    "^@sveltejs/(.*)$",
    "^$lib/components/ui/(.*)$",
    "^$lib/components/(.*)$",
    "^$lib/(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^[./]"
  ]
}
