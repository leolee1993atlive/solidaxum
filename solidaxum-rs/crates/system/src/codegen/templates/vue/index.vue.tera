{# Vue CRUD page — generated by solidaxum codegen #}
{# Generated at: {{ datetime }} #}
<template>
  <div class="app-container">
    <!-- 搜索区域 -->
    <el-form :model="queryParams" ref="queryFormRef" :inline="true" v-show="showSearch" label-width="68px">
{%- for col in query_columns %}
      <el-form-item label="{{ col.columnComment }}" prop="{{ col.javaField }}">
{%- if col.htmlType == "input" or col.htmlType == "textarea" %}
        <el-input
          v-model="queryParams.{{ col.javaField }}"
          placeholder="请输入{{ col.columnComment }}"
          clearable
          style="width: 180px"
          @keyup.enter="handleQuery"
        />
{%- elif col.htmlType == "select" or col.htmlType == "radio" %}
        <el-select
          v-model="queryParams.{{ col.javaField }}"
          placeholder="请选择{{ col.columnComment }}"
          clearable
          style="width: 180px"
        >
{%- if col.dictType %}
          <el-option
            v-for="dict in {{ col.dictType }}"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
{%- endif %}
        </el-select>
{%- elif col.htmlType == "datetime" %}
        <el-date-picker
          v-model="queryParams.{{ col.javaField }}"
          type="date"
          value-format="YYYY-MM-DD"
          placeholder="选择{{ col.columnComment }}"
          clearable
        />
{%- elif col.htmlType == "inputNumber" %}
        <el-input-number v-model="queryParams.{{ col.javaField }}" controls-position="right" />
{%- else %}
        <el-input v-model="queryParams.{{ col.javaField }}" placeholder="请输入{{ col.columnComment }}" clearable style="width: 180px" />
{%- endif %}
      </el-form-item>
{%- endfor %}
      <el-form-item>
        <el-button type="primary" icon="Search" @click="handleQuery">搜索</el-button>
        <el-button icon="Refresh" @click="resetQuery">重置</el-button>
      </el-form-item>
    </el-form>

    <!-- 操作按钮 -->
    <el-row :gutter="10" class="mb8">
      <el-col :span="1.5">
        <el-button type="primary" plain icon="Plus" @click="handleAdd" v-hasPermi="['{{ permission_prefix }}:add']">新增</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="success" plain icon="Edit" :disabled="single" @click="handleUpdate()" v-hasPermi="['{{ permission_prefix }}:edit']">修改</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button type="danger" plain icon="Delete" :disabled="multiple" @click="handleDelete()" v-hasPermi="['{{ permission_prefix }}:remove']">删除</el-button>
      </el-col>
      <right-toolbar v-model:show-search="showSearch" @query-table="getList" />
    </el-row>

    <!-- 数据表格 -->
    <el-table v-loading="loading" :data="{{ business_name }}List" @selection-change="handleSelectionChange">
      <el-table-column type="selection" width="55" align="center" />
{%- for col in list_columns %}
{%- if col.htmlType == "select" or col.htmlType == "radio" or col.htmlType == "checkbox" %}
{%- if col.dictType %}
      <el-table-column label="{{ col.columnComment }}" align="center" prop="{{ col.javaField }}">
        <template #default="scope">
          <dict-tag :options="{{ col.dictType }}" :value="scope.row.{{ col.javaField }}" />
        </template>
      </el-table-column>
{%- else %}
      <el-table-column label="{{ col.columnComment }}" align="center" prop="{{ col.javaField }}" />
{%- endif %}
{%- elif col.htmlType == "datetime" %}
      <el-table-column label="{{ col.columnComment }}" align="center" prop="{{ col.javaField }}" width="160" />
{%- else %}
      <el-table-column label="{{ col.columnComment }}" align="center" prop="{{ col.javaField }}" />
{%- endif %}
{%- endfor %}
      <el-table-column label="操作" align="center" class-name="small-padding fixed-width">
        <template #default="scope">
          <el-button link type="primary" icon="Edit" @click="handleUpdate(scope.row)" v-hasPermi="['{{ permission_prefix }}:edit']">修改</el-button>
          <el-button link type="primary" icon="Delete" @click="handleDelete(scope.row)" v-hasPermi="['{{ permission_prefix }}:remove']">删除</el-button>
        </template>
      </el-table-column>
    </el-table>

    <pagination
      v-show="total > 0"
      :total="total"
      v-model:page="queryParams.pageNum"
      v-model:limit="queryParams.pageSize"
      @pagination="getList"
    />

    <!-- 新增/修改对话框 -->
    <el-dialog :title="dialog.title" v-model="dialog.visible" width="500px" append-to-body>
      <el-form ref="{{ business_name }}Ref" :model="form" :rules="rules" label-width="80px">
{%- for col in columns %}
{%- if (col.isInsert == "1" or col.isEdit == "1") and col.isPk != "1" and col.javaField != "createBy" and col.javaField != "createTime" and col.javaField != "updateBy" and col.javaField != "updateTime" %}
        <el-form-item label="{{ col.columnComment }}" prop="{{ col.javaField }}">
{%- if col.htmlType == "textarea" %}
          <el-input v-model="form.{{ col.javaField }}" type="textarea" placeholder="请输入内容" />
{%- elif col.htmlType == "inputNumber" %}
          <el-input-number v-model="form.{{ col.javaField }}" controls-position="right" />
{%- elif col.htmlType == "select" %}
          <el-select v-model="form.{{ col.javaField }}" placeholder="请选择{{ col.columnComment }}">
{%- if col.dictType %}
            <el-option v-for="dict in {{ col.dictType }}" :key="dict.value" :label="dict.label" :value="dict.value" />
{%- endif %}
          </el-select>
{%- elif col.htmlType == "radio" %}
          <el-radio-group v-model="form.{{ col.javaField }}">
{%- if col.dictType %}
            <el-radio v-for="dict in {{ col.dictType }}" :key="dict.value" :value="dict.value">{{ "{{" }} dict.label {{ "}}" }}</el-radio>
{%- endif %}
          </el-radio-group>
{%- elif col.htmlType == "datetime" %}
          <el-date-picker v-model="form.{{ col.javaField }}" type="datetime" value-format="YYYY-MM-DD HH:mm:ss" placeholder="选择{{ col.columnComment }}" />
{%- elif col.htmlType == "switch" %}
          <el-switch v-model="form.{{ col.javaField }}" active-value="0" inactive-value="1" />
{%- else %}
          <el-input v-model="form.{{ col.javaField }}" placeholder="请输入{{ col.columnComment }}" />
{%- endif %}
        </el-form-item>
{%- endif %}
{%- endfor %}
      </el-form>
      <template #footer>
        <el-button type="primary" :loading="buttonLoading" @click="submitForm">确 定</el-button>
        <el-button @click="cancel">取 消</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup lang="ts" name="{{ business_name_cap }}">
import {
  add{{ business_name_cap }},
  del{{ business_name_cap }},
  get{{ business_name_cap }},
  list{{ business_name_cap }},
  update{{ business_name_cap }},
} from '@/api/{{ module_name }}/{{ business_name }}';
import type {
  {{ business_name_cap }}Form,
  {{ business_name_cap }}Query,
  {{ business_name_cap }}VO,
} from '@/api/{{ module_name }}/{{ business_name }}/types';
{%- if dicts %}

const { {{ dicts | replace(from="'", to="") }} } = toRefs<any>(useDict({{ dicts }}));
{%- endif %}

const { proxy } = getCurrentInstance() as ComponentInternalInstance;
const {{ business_name }}List = ref<{{ business_name_cap }}VO[]>([]);
const buttonLoading = ref(false);
const loading = ref(true);
const showSearch = ref(true);
const ids = ref<Array<number | string>>([]);
const single = ref(true);
const multiple = ref(true);
const total = ref(0);

const queryFormRef = ref<FormInstance>();
const {{ business_name }}Ref = ref<FormInstance>();

const initFormData: {{ business_name_cap }}Form = {
{%- for col in columns %}
{%- if (col.isInsert == "1" or col.isEdit == "1") and col.isPk != "1" and col.javaField != "createBy" and col.javaField != "createTime" and col.javaField != "updateBy" and col.javaField != "updateTime" %}
  {{ col.javaField }}: undefined,
{%- endif %}
{%- endfor %}
};

const dialog = reactive({ visible: false, title: '' });

const data = reactive<{
  form: {{ business_name_cap }}Form;
  queryParams: {{ business_name_cap }}Query;
  rules: Record<string, any[]>;
}>({
  form: { ...initFormData },
  queryParams: {
    pageNum: 1,
    pageSize: 10,
{%- for col in query_columns %}
    {{ col.javaField }}: undefined,
{%- endfor %}
  },
  rules: {
{%- for col in columns %}
{%- if (col.isInsert == "1" or col.isEdit == "1") and col.isRequired == "1" and col.isPk != "1" %}
    {{ col.javaField }}: [
      { required: true, message: "{{ col.columnComment }}不能为空", trigger: "blur" },
    ],
{%- endif %}
{%- endfor %}
  },
});

const { queryParams, form, rules } = toRefs(data);

/** 查询{{ function_name }}列表 */
const getList = async () => {
  loading.value = true;
  const res = await list{{ business_name_cap }}(queryParams.value);
  {{ business_name }}List.value = res.rows;
  total.value = res.total;
  loading.value = false;
};

/** 搜索按钮 */
const handleQuery = () => {
  queryParams.value.pageNum = 1;
  getList();
};

/** 重置搜索 */
const resetQuery = () => {
  queryFormRef.value?.resetFields();
  handleQuery();
};

/** 多选框选中数据 */
const handleSelectionChange = (selection: {{ business_name_cap }}VO[]) => {
  ids.value = selection.map((item) => item.{{ pk_field_js }});
  single.value = selection.length !== 1;
  multiple.value = !selection.length;
};

/** 重置表单 */
const reset = () => {
  form.value = { ...initFormData };
  {{ business_name }}Ref.value?.resetFields();
};

/** 新增按钮 */
const handleAdd = () => {
  reset();
  dialog.visible = true;
  dialog.title = '添加{{ function_name }}';
};

/** 修改按钮 */
const handleUpdate = async (row?: {{ business_name_cap }}VO) => {
  reset();
  const {{ pk_field_js }} = row?.{{ pk_field_js }} ?? ids.value[0];
  const res = await get{{ business_name_cap }}({{ pk_field_js }});
  Object.assign(form.value, res.data);
  dialog.visible = true;
  dialog.title = '修改{{ function_name }}';
};

/** 提交按钮 */
const submitForm = () => {
  {{ business_name }}Ref.value?.validate(async (valid: boolean) => {
    if (!valid) return;
    buttonLoading.value = true;
    try {
      if (form.value.{{ pk_field_js }}) {
        await update{{ business_name_cap }}(form.value);
      } else {
        await add{{ business_name_cap }}(form.value);
      }
      proxy?.$modal.msgSuccess('操作成功');
      dialog.visible = false;
      await getList();
    } finally {
      buttonLoading.value = false;
    }
  });
};

/** 删除按钮 */
const handleDelete = async (row?: {{ business_name_cap }}VO) => {
  const {{ pk_field_js }}s = row?.{{ pk_field_js }} ?? ids.value;
  await proxy?.$modal.confirm('确认删除编号为"' + {{ pk_field_js }}s + '"的数据项？');
  await del{{ business_name_cap }}({{ pk_field_js }}s);
  proxy?.$modal.msgSuccess('删除成功');
  await getList();
};

/** 取消按钮 */
const cancel = () => {
  dialog.visible = false;
  reset();
};

onMounted(() => {
  getList();
});
</script>
